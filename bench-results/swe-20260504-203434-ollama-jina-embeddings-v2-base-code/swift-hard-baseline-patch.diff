+                    expect(variableTypeName("Array<Int,>").isArray).to(beTrue())
+                    expect(variableTypeName("Array<Int,>").array?.elementTypeName.name).to(equal("Int"))
+                }
+
+                it("handles Dictionary with trailing comma") {
+                    expect(variableTypeName("Dictionary<String, Int,>").isDictionary).to(beTrue())
