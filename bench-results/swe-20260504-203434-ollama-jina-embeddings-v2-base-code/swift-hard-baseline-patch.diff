+                    expect(variableTypeName("Set<Int,>").set?.elementTypeName.name).to(equal("Int"))
+                }
+
+                it("handles complex generic with trailing comma") {
+                    let complexType = variableTypeName("OrderedDictionary<String, (status: Result<Int, Error>, messages: [String]),>")
+                    expect(complexType.generic).toNot(beNil())
+                }
+            }
+
