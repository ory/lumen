diff --git a/test/c-test.cc b/test/c-test.cc
new file mode 100644
index 0000000..8c30c8d
--- /dev/null
+++ b/test/c-test.cc
@@ -0,0 +1,36 @@
+// Formatting library for C++ - tests of the C API
+//
+// Copyright (c) 2012 - present, Victor Zverovich
+// All rights reserved.
+//
+// For the license information refer to format.h.
+
+#include "fmt/fmt-c.h"
+
+#include <string>
+
+#include "gtest/gtest.h"
+
+TEST(c_test, vformat) {
+  char buf[100];
+  fmt_arg args[] = {fmt_from_int(42), fmt_from_cstring("abc"),
+                    fmt_from_double(1.5), fmt_from_bool(1),
+                    fmt_from_string("xyz!", 3), fmt_from_char('c')};
+  int n = fmt_vformat(buf, sizeof(buf), "{} {} {} {} {} {}", args, 6);
+  EXPECT_EQ(std::string(buf), "42 abc 1.5 true xyz c");
+  EXPECT_EQ(n, 21);
+}
+
+TEST(c_test, truncation) {
+  char buf[4];
+  fmt_arg arg = fmt_from_long_long(123456);
+  EXPECT_EQ(fmt_vformat(buf, sizeof(buf), "{}", &arg, 1), 6);
+  EXPECT_EQ(std::string(buf), "123");
+  EXPECT_EQ(fmt_vformat(nullptr, 0, "{}", &arg, 1), 6);
+}
+
+TEST(c_test, error) {
+  char buf[10];
+  EXPECT_EQ(fmt_vformat(buf, sizeof(buf), "{", nullptr, 0), -1);
+  EXPECT_EQ(fmt_vformat(buf, sizeof(buf), "{}", nullptr, 0), -1);
+}
