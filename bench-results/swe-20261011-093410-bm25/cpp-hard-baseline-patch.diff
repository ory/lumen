diff --git a/test/c-test.c b/test/c-test.c
new file mode 100644
index 0000000..1635008
--- /dev/null
+++ b/test/c-test.c
@@ -0,0 +1,39 @@
+// Formatting library for C++ - tests of the C API
+//
+// Copyright (c) 2012 - present, Victor Zverovich
+// All rights reserved.
+//
+// For the license information refer to format.h.
+
+#include <stdio.h>
+#include <string.h>
+
+#include "fmt/fmt-c.h"
+
+static int failures;
+
+#define CHECK(cond)                                        \
+  do {                                                     \
+    if (!(cond)) {                                         \
+      fprintf(stderr, "%s:%d: failed: %s\n", __FILE__,     \
+              __LINE__, #cond);                            \
+      ++failures;                                          \
+    }                                                      \
+  } while (0)
+
+int main(void) {
+  char buf[100];
+  int n = fmt_format(buf, sizeof(buf), "{} {} {:.2f} {} {}", 42, "hi", 3.14159,
+                     (char)'c', (_Bool)1);
+  CHECK(n == 17);
+  CHECK(strcmp(buf, "42 hi 3.14 c true") == 0);
+
+  n = fmt_format(buf, 4, "abcdefgh");
+  CHECK(n == 8);
+  CHECK(strcmp(buf, "abc") == 0);
+
+  CHECK(fmt_format(NULL, 0, "{}", 12345u) == 5);
+  CHECK(fmt_format(buf, sizeof(buf), "{:d}", "x") < 0);
+  CHECK(fmt_format(buf, sizeof(buf), "{} {}", 1) < 0);
+  return failures != 0;
+}
